      "parameters": {
        "jsCode": "// Read body reliably (n8n webhook usually provides $json.body)\nconst body = $json.body ?? $json;\nconst email = String(body.email ?? '').trim().toLowerCase();\nconst pass = String(body.pass ?? '').trim();\n\n// Fake login: ANY email is valid if pass === \"1234\"\nconst loginOk = (pass === '1234');\nconst statusCode = loginOk ? 200 : 401;\n\nreturn [{\n  email,\n  statusCode\n}];"
      },
