        "jsCode": "const email = $json.email;\nconst data = $getWorkflowStaticData('global');\nif (!data.attemptsByEmail) data.attemptsByEmail = {};\n\nconst prev = data.attemptsByEmail[email];\nconst count = prev + 1;\n\ndata.attemptsByEmail[email] = count;\n\nreturn [{\n  email,\n  prevAttempts: prev,\n  failedAttempts: count,\n  reached5: (count >= 5)\n}];"
